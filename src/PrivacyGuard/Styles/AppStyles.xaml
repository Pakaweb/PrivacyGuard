<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="HistorySuccessBadgeBackgroundBrush" Color="#3D16A35E" />
      <SolidColorBrush x:Key="HistorySuccessBadgeBorderBrush" Color="#6CCB5F" />
      <SolidColorBrush x:Key="HistorySuccessBadgeForegroundBrush" Color="#8FDC86" />
      <SolidColorBrush x:Key="DashboardRestartBackgroundBrush" Color="#241C10" />
      <SolidColorBrush x:Key="DashboardRestartStripeBrush" Color="#C9A15B" />
      <SolidColorBrush x:Key="DashboardResetBackgroundBrush" Color="#1A222C" />
      <SolidColorBrush x:Key="DashboardResetStripeBrush" Color="#7EA2C8" />
      <SolidColorBrush x:Key="DashboardSearchBackgroundBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="DiagTrackTradeOffBackgroundBrush" Color="#3DE88A1A" />
      <SolidColorBrush x:Key="DiagTrackTradeOffForegroundBrush" Color="#F0C36A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="HistorySuccessBadgeBackgroundBrush" Color="#B7E6C6" />
      <SolidColorBrush x:Key="HistorySuccessBadgeBorderBrush" Color="#10893E" />
      <SolidColorBrush x:Key="HistorySuccessBadgeForegroundBrush" Color="#0B6A14" />
      <SolidColorBrush x:Key="DashboardRestartBackgroundBrush" Color="#F7F1E4" />
      <SolidColorBrush x:Key="DashboardRestartStripeBrush" Color="#9A7420" />
      <SolidColorBrush x:Key="DashboardResetBackgroundBrush" Color="#EEF3F8" />
      <SolidColorBrush x:Key="DashboardResetStripeBrush" Color="#4F7394" />
      <SolidColorBrush x:Key="DashboardSearchBackgroundBrush" Color="#0A000000" />
      <SolidColorBrush x:Key="DiagTrackTradeOffBackgroundBrush" Color="#33C97B23" />
      <SolidColorBrush x:Key="DiagTrackTradeOffForegroundBrush" Color="#9A5B12" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Thickness x:Key="PagePadding">28,18,28,28</Thickness>
  <x:Double x:Key="CardMinWidth">280</x:Double>

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="PrivacyCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18,16,18,16" />
  </Style>

  <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource PrivacyCardStyle}">
    <Setter Property="Padding" Value="24,22" />
    <Setter Property="MinHeight" Value="268" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="DashboardAlertStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style x:Key="DashboardFilterChipStyle" TargetType="ToggleButton">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,12,0,2" />
    <Setter Property="CharacterSpacing" Value="20" />
  </Style>

  <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="2,0,0,16" />
  </Style>

  <Style x:Key="QuietBadgeStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style x:Key="HealthPillBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingSectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>

  <Style x:Key="SettingRowStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="72" />
  </Style>

  <Style x:Key="DashboardComboBoxStyle" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,8,36,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MaxDropDownHeight" Value="380" />
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="SettingComboBoxStyle" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,8,36,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MaxDropDownHeight" Value="380" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
    <Setter Property="FocusVisualMargin" Value="-3" />
  </Style>

  <Style x:Key="QuietIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
  </Style>

  <Style x:Key="ProfileSectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="40" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="2,4,0,10" />
  </Style>

  <Style x:Key="SettingOutlinedButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
    <Setter Property="FocusVisualMargin" Value="-3" />
  </Style>

  <Style x:Key="DashboardActionButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
    <Setter Property="FocusVisualMargin" Value="-3" />
  </Style>

  <Style x:Key="HistoryActionButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
    <Setter Property="FocusVisualMargin" Value="-3" />
  </Style>
</ResourceDictionary>
