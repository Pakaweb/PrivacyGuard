<UserControl
    x:Class="PrivacyGuard.Views.CustomProfileEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PrivacyGuard.Models"
    xmlns:vm="using:PrivacyGuard.ViewModels">

  <ScrollViewer MaxHeight="520" Padding="0,0,8,0">
    <StackPanel Spacing="14">
      <TextBox
          x:Name="NameBox"
          Header="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.customName'), Mode=OneWay}"
          PlaceholderText="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.customNamePlaceholder'), Mode=OneWay}"
          Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.editorSubtitle'), Mode=OneWay}"
          TextWrapping="Wrap" />

      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
        <ItemsRepeater.Layout>
          <StackLayout Spacing="10" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:CustomProfileSettingRow">
            <Border
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Opacity="{x:Bind IsIncluded, Mode=OneWay, Converter={StaticResource IncludedOpacityConverter}}">
              <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                  <TextBlock
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind Description}"
                      TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="{x:Bind IncludeLabel}"
                    IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />

                <ComboBox
                    Grid.Row="1"
                    MinWidth="240"
                    HorizontalAlignment="Left"
                    IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                    ItemsSource="{x:Bind TelemetryLevels}"
                    SelectedItem="{x:Bind TelemetryLevel, Mode=TwoWay}"
                    Style="{StaticResource DashboardComboBoxStyle}"
                    Visibility="{x:Bind IsTelemetry, Converter={StaticResource BoolToVisibilityConverter}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TelemetryLevel">
                      <TextBlock Text="{x:Bind Converter={StaticResource TelemetryLevelToLabelConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox
                    Grid.Row="1"
                    MinWidth="240"
                    HorizontalAlignment="Left"
                    IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                    ItemsSource="{x:Bind ServiceStates}"
                    SelectedItem="{x:Bind ServiceState, Mode=TwoWay}"
                    Style="{StaticResource DashboardComboBoxStyle}"
                    Visibility="{x:Bind IsService, Converter={StaticResource BoolToVisibilityConverter}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DesiredServiceState">
                      <TextBlock Text="{x:Bind Converter={StaticResource ServiceStateToLabelConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <ToggleSwitch
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    IsEnabled="{x:Bind IsIncluded, Mode=OneWay}"
                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                    OffContent="Off"
                    OnContent="On"
                    Visibility="{x:Bind IsToggle, Converter={StaticResource BoolToVisibilityConverter}}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </StackPanel>
  </ScrollViewer>
</UserControl>
