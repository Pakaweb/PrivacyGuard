<Page
    x:Class="PrivacyGuard.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:vm="using:PrivacyGuard.ViewModels"
    NavigationCacheMode="Disabled">

  <Page.Resources>
    <DataTemplate x:Key="ProfileCardTemplate" x:DataType="vm:ProfileOption">
      <Border
          MinHeight="460"
          Padding="22,20"
          Margin="2,4,2,10"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{x:Bind CardState, Mode=OneWay, Converter={StaticResource ProfileBorderBrushConverter}}"
          BorderThickness="{x:Bind CardState, Mode=OneWay, Converter={StaticResource ProfileBorderThicknessConverter}}"
          CornerRadius="12"
          PointerEntered="ProfileCard_PointerEntered"
          PointerExited="ProfileCard_PointerExited">
        <Grid>
          <Border
              Margin="-22,-20,-22,-20"
              Background="{ThemeResource AccentFillColorDefaultBrush}"
              Opacity="0.12"
              CornerRadius="11"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsHitTestVisible="False"
              Visibility="{x:Bind IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}" />
          <Border
              Margin="-22,-20,-22,-20"
              Background="{ThemeResource AccentFillColorDefaultBrush}"
              Opacity="0.07"
              CornerRadius="11"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsHitTestVisible="False"
              Visibility="{x:Bind IsCustom, Converter={StaticResource BoolToVisibilityConverter}}" />
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                  Width="44"
                  Height="44"
                  Background="{x:Bind Converter={StaticResource ProfileIconBackgroundConverter}}"
                  CornerRadius="12">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    Foreground="{x:Bind Converter={StaticResource ProfileIconForegroundConverter}}"
                    Glyph="{x:Bind Glyph}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind ScoreImpactLabel, Mode=OneWay}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind LastModifiedLabel, Mode=OneWay}"
                    Visibility="{x:Bind LastModifiedLabel, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind LastAppliedLabel, Mode=OneWay}"
                    Visibility="{x:Bind LastAppliedLabel, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                  <Border
                      Padding="8,3"
                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                      CornerRadius="8"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind RecommendedBadgeLabel}" />
                  </Border>
                  <Border
                      Padding="8,3"
                      Background="{ThemeResource AccentFillColorTertiaryBrush}"
                      CornerRadius="8"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind IsCustom, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind CustomBadgeLabel}" />
                  </Border>
                  <Button
                      Command="{x:Bind EditCommand}"
                      CommandParameter="{x:Bind Profile}"
                      Style="{StaticResource QuietIconButtonStyle}"
                      ToolTipService.ToolTip="{x:Bind EditLabel}"
                      Visibility="{x:Bind IsCustom, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                  </Button>
                  <Button
                      Command="{x:Bind DeleteCommand}"
                      CommandParameter="{x:Bind Profile}"
                      Style="{StaticResource QuietIconButtonStyle}"
                      ToolTipService.ToolTip="{x:Bind DeleteLabel}"
                      Visibility="{x:Bind IsCustom, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                  </Button>
                </StackPanel>
                <Border
                    Padding="8,3"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource HistorySuccessBadgeBackgroundBrush}"
                    BorderBrush="{ThemeResource HistorySuccessBadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock
                      FontSize="10"
                      FontWeight="SemiBold"
                      Foreground="{ThemeResource HistorySuccessBadgeForegroundBrush}"
                      Text="{x:Bind ActiveLabel}" />
                </Border>
              </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="1"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Summary}"
                TextWrapping="Wrap" />

            <ItemsRepeater Grid.Row="2" Margin="0,2,0,0" ItemsSource="{x:Bind Highlights}">
              <ItemsRepeater.Layout>
                <UniformGridLayout
                    MinColumnSpacing="6"
                    MinItemWidth="108"
                    MinRowSpacing="6" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <Border
                      Padding="8,5"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      CornerRadius="8">
                    <TextBlock
                        FontSize="11"
                        Text="{x:Bind}"
                        TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border
                Grid.Row="3"
                Margin="0,2,0,0"
                Padding="10,8"
                Background="{x:Bind CardState, Mode=OneWay, Converter={StaticResource ProfileWarningBackgroundConverter}}"
                BorderBrush="{x:Bind CardState, Mode=OneWay, Converter={StaticResource ProfileWarningAccentConverter}}"
                BorderThickness="3,0,0,0"
                CornerRadius="8">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Glyph="&#xE7BA;" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock
                      FontSize="11"
                      FontWeight="SemiBold"
                      Text="{x:Bind BeforeContinueLabel}" />
                  <TextBlock
                      FontSize="12"
                      LineHeight="16"
                      Opacity="0.92"
                      Text="{x:Bind Warning}"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Button
                Grid.Row="4"
                MinHeight="40"
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ApplyCommand}"
                CommandParameter="{x:Bind Profile}"
                Content="{x:Bind ApplyButtonLabel, Mode=OneWay}"
                IsEnabled="{x:Bind CanApply, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ShowAccentApply, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button
                Grid.Row="4"
                MinHeight="40"
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ApplyCommand}"
                CommandParameter="{x:Bind Profile}"
                Content="{x:Bind ApplyButtonLabel, Mode=OneWay}"
                IsEnabled="{x:Bind CanApply, Mode=OneWay}"
                Visibility="{x:Bind ShowStandardApply, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Padding="{StaticResource PagePadding}" Spacing="8">
      <StackPanel Margin="0,0,0,8">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.title'), Mode=OneWay}" />
        <TextBlock
            Style="{StaticResource PageSubtitleStyle}"
            Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.subtitle'), Mode=OneWay}" />
      </StackPanel>

      <InfoBar
          Margin="0,0,0,16"
          IsClosable="False"
          IsOpen="True"
          Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
          Severity="Informational"
          Title="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.safety'), Mode=OneWay}" />

      <StackPanel
          Margin="0,0,0,16"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            Command="{x:Bind ViewModel.CreateCustomProfileCommand}"
            Style="{StaticResource AccentButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE710;" />
            <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.createCustom'), Mode=OneWay}" />
          </StackPanel>
        </Button>
        <Button Command="{x:Bind ViewModel.ExportCommand}" Style="{StaticResource SettingOutlinedButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xEDE1;" />
            <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'common.export'), Mode=OneWay}" />
          </StackPanel>
        </Button>
        <Button Command="{x:Bind ViewModel.ImportCommand}" Style="{StaticResource SettingOutlinedButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE8B5;" />
            <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'common.import'), Mode=OneWay}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <TextBlock
          Style="{StaticResource ProfileSectionHeaderStyle}"
          Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.customSection'), Mode=OneWay}" />

      <Border
          MaxWidth="560"
          Margin="2,0,2,8"
          Padding="28,26"
          HorizontalAlignment="Left"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Visibility="{x:Bind ViewModel.HasCustomProfiles, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
        <StackPanel MaxWidth="520" Spacing="10">
          <Border
              Width="44"
              Height="44"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              CornerRadius="12">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="18"
                Glyph="&#xE70F;" />
          </Border>
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.emptyCustomTitle'), Mode=OneWay}" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.emptyCustomBody'), Mode=OneWay}"
              TextWrapping="Wrap" />
          <Button
              Margin="0,6,0,0"
              HorizontalAlignment="Left"
              Command="{x:Bind ViewModel.CreateCustomProfileCommand}"
              Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontSize="14" Glyph="&#xE710;" />
              <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.createFirstCustom'), Mode=OneWay}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <ItemsRepeater
          MaxWidth="1120"
          HorizontalAlignment="Left"
          ItemTemplate="{StaticResource ProfileCardTemplate}"
          ItemsSource="{x:Bind ViewModel.CustomProfiles}"
          Visibility="{x:Bind ViewModel.HasCustomProfiles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
        <ItemsRepeater.Layout>
          <UniformGridLayout
              MaximumRowsOrColumns="2"
              MinColumnSpacing="18"
              MinItemHeight="460"
              MinItemWidth="360"
              MinRowSpacing="18" />
        </ItemsRepeater.Layout>
      </ItemsRepeater>

      <TextBlock
          Margin="2,18,0,10"
          Style="{StaticResource ProfileSectionHeaderStyle}"
          Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'profiles.builtInSection'), Mode=OneWay}" />

      <ItemsRepeater
          MaxWidth="1120"
          HorizontalAlignment="Left"
          ItemTemplate="{StaticResource ProfileCardTemplate}"
          ItemsSource="{x:Bind ViewModel.BuiltInProfiles}">
        <ItemsRepeater.Layout>
          <UniformGridLayout
              MaximumRowsOrColumns="2"
              MinColumnSpacing="18"
              MinItemHeight="460"
              MinItemWidth="360"
              MinRowSpacing="18" />
        </ItemsRepeater.Layout>
      </ItemsRepeater>
    </StackPanel>
  </ScrollViewer>
</Page>
