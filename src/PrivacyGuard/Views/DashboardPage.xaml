<Page
    x:Class="PrivacyGuard.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:PrivacyGuard.Views.Controls"
    xmlns:models="using:PrivacyGuard.Models"
    xmlns:vm="using:PrivacyGuard.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

  <Page.Resources>
    <DataTemplate x:Key="SettingCardTemplate" x:DataType="vm:PrivacyStatusItem">
      <Border
          MinHeight="168"
          Margin="0,0,0,2"
          Padding="18,16"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="12"
          PointerEntered="SettingCard_PointerEntered"
          PointerExited="SettingCard_PointerExited">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Ellipse
              Width="9"
              Height="9"
              Margin="0,10,0,0"
              VerticalAlignment="Top"
              Fill="{x:Bind Converter={StaticResource StatusDotBrushConverter}, Mode=OneWay}" />
          <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                  Width="40"
                  Height="40"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  CornerRadius="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    Glyph="{x:Bind Glyph}" />
              </Border>
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Text="{x:Bind Title}"
                  TextWrapping="Wrap" />
              <FontIcon
                  Grid.Column="2"
                  VerticalAlignment="Top"
                  FontFamily="Segoe Fluent Icons"
                  FontSize="12"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  Glyph="&#xEA18;"
                  ToolTipService.ToolTip="{x:Bind RequiresAdminTooltip}"
                  Visibility="{x:Bind NeedsElevationHint, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <TextBlock
                Grid.Row="1"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                LineHeight="18"
                Text="{x:Bind Description}"
                TextWrapping="Wrap" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                  VerticalAlignment="Center"
                  FontSize="12"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{x:Bind ValueLabel, Mode=OneWay}"
                  Visibility="{x:Bind ShowValueLabel, Converter={StaticResource BoolToVisibilityConverter}}" />
              <ToggleSwitch
                  Grid.Column="1"
                  MinWidth="40"
                  OffContent=""
                  OnContent=""
                  IsEnabled="{x:Bind CanInteract}"
                  IsOn="{x:Bind IsOn, Mode=OneWay}"
                  Loaded="PrivacyToggle_Loaded"
                  Tag="{x:Bind}"
                  Toggled="PrivacyToggle_Toggled"
                  Unloaded="PrivacyToggle_Unloaded"
                  Visibility="{x:Bind UseToggle, Converter={StaticResource BoolToVisibilityConverter}}" />
              <Button
                  Grid.Column="1"
                  MinWidth="96"
                  MinHeight="32"
                  Command="{x:Bind ChangeCommand}"
                  CommandParameter="{x:Bind}"
                  Content="{x:Bind ActionLabel, Mode=OneWay}"
                  IsEnabled="{x:Bind CanInteract}"
                  Visibility="{x:Bind IsServiceControl, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind LastChangedLabel, Mode=OneWay}" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <ScrollViewer>
      <StackPanel Padding="{StaticResource PagePadding}" Spacing="0">
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.title'), Mode=OneWay}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0" Text="{x:Bind ViewModel.EditionLabel, Mode=OneWay}" />
          </StackPanel>
          <Button
              Grid.Column="1"
              VerticalAlignment="Top"
              Command="{x:Bind ViewModel.RefreshCommand}"
              IsEnabled="{x:Bind ViewModel.CanApplyChanges, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE72C;" />
              <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'common.refresh'), Mode=OneWay}" />
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Margin="0,0,0,20" Spacing="8">
          <InfoBar
              IsClosable="True"
              IsOpen="{x:Bind ViewModel.IsToastOpen, Mode=TwoWay}"
              Message="{x:Bind ViewModel.ToastMessage, Mode=OneWay}"
              Severity="{x:Bind ViewModel.ToastKind, Mode=OneWay, Converter={StaticResource InfoKindToSeverityConverter}}"
              Title="{x:Bind ViewModel.ToastTitle, Mode=OneWay}" />

          <Border
              Style="{StaticResource DashboardAlertStyle}"
              Padding="0"
              Background="{ThemeResource DashboardRestartBackgroundBrush}"
              Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border
                  Background="{ThemeResource DashboardRestartStripeBrush}"
                  CornerRadius="10,0,0,10" />
              <Grid Grid.Column="1" Padding="14,10,14,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="16">
                  <FontIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Glyph="&#xEA18;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.restartBannerTitle'), Mode=OneWay}" />
                  <TextBlock
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.restartBannerBody'), Mode=OneWay}"
                      TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RestartElevatedCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72E;" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.restartAdmin'), Mode=OneWay}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>
          </Border>

          <Border
              Style="{StaticResource DashboardAlertStyle}"
              Padding="12,8"
              Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon
                  VerticalAlignment="Center"
                  FontSize="14"
                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                  Glyph="&#xE73E;" />
              <TextBlock
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.adminTitle'), Mode=OneWay}" />
              <TextBlock
                  VerticalAlignment="Center"
                  FontSize="12"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              Style="{StaticResource DashboardAlertStyle}"
              Padding="0"
              Background="{ThemeResource DashboardResetBackgroundBrush}"
              Visibility="{x:Bind ViewModel.HasWindowsReset, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border
                  Background="{ThemeResource DashboardResetStripeBrush}"
                  CornerRadius="10,0,0,10" />
              <Grid Grid.Column="1" Padding="14,10,14,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="16">
                  <FontIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Glyph="&#xE7BA;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.windowsResetTitle'), Mode=OneWay}" />
                  <TextBlock
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind ViewModel.ResetSummary, Mode=OneWay}"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                  <Button
                      Command="{x:Bind ViewModel.ReapplyLastProfileCommand}"
                      IsEnabled="{x:Bind ViewModel.CanReapplyLastProfile, Mode=OneWay}"
                      Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon FontSize="14" Glyph="&#xE777;" />
                      <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.reapplyLastProfile'), Mode=OneWay}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{x:Bind ViewModel.DismissWindowsResetCommand}">
                    <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'common.dismiss'), Mode=OneWay}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>

        <Grid Margin="0,0,0,20" ColumnSpacing="10" RowSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <AutoSuggestBox
              MinHeight="40"
              VerticalAlignment="Center"
              QueryIcon="Find"
              PlaceholderText="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.searchPlaceholder'), Mode=OneWay}"
              Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
              TextChanged="SearchBox_TextChanged" />
          <Button
              Grid.Column="1"
              MinWidth="32"
              MinHeight="32"
              Padding="0"
              VerticalAlignment="Center"
              Command="{x:Bind ViewModel.ClearSearchCommand}"
              ToolTipService.ToolTip="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'common.clear'), Mode=OneWay}"
              Visibility="{x:Bind ViewModel.HasSearchText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon FontSize="12" Glyph="&#xE711;" />
          </Button>
          <StackPanel
              Grid.Column="2"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="6">
            <ToggleButton
                Command="{x:Bind ViewModel.SetCardFilterCommand}"
                CommandParameter="All"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.filterAll'), Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}"
                Style="{StaticResource DashboardFilterChipStyle}" />
            <ToggleButton
                Command="{x:Bind ViewModel.SetCardFilterCommand}"
                CommandParameter="Collecting"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.filterCollecting'), Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsFilterCollecting, Mode=OneWay}"
                Style="{StaticResource DashboardFilterChipStyle}" />
            <ToggleButton
                Command="{x:Bind ViewModel.SetCardFilterCommand}"
                CommandParameter="Protected"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.filterProtected'), Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsFilterProtected, Mode=OneWay}"
                Style="{StaticResource DashboardFilterChipStyle}" />
          </StackPanel>
        </Grid>

        <StackPanel
            Margin="0,0,0,20"
            HorizontalAlignment="Left"
            Spacing="4"
            Visibility="{x:Bind ViewModel.HasNoSearchResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.noResults'), Mode=OneWay}" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.noResultsBody'), Mode=OneWay}" />
        </StackPanel>

        <Grid Margin="0,0,0,8" ColumnSpacing="16" MinHeight="268">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" MinWidth="0" />
            <ColumnDefinition Width="*" MinWidth="0" />
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource HeroCardStyle}">
            <Grid ColumnSpacing="28" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:ScoreRing
                  VerticalAlignment="Center"
                  Caption="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.outOf100'), Mode=OneWay}"
                  Value="{x:Bind ViewModel.ScoreValue, Mode=OneWay}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.privacyScore'), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock
                      FontSize="22"
                      FontWeight="SemiBold"
                      Text="{x:Bind ViewModel.HealthLabel, Mode=OneWay}" />
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind ViewModel.LastRefreshedLabel, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ScoreSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Expander
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.whyScore'), Mode=OneWay}"
                    IsExpanded="False">
                  <ListView
                      MaxHeight="200"
                      IsItemClickEnabled="False"
                      SelectionMode="None"
                      ItemsSource="{x:Bind ViewModel.ScoreFactors, Mode=OneWay}">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="models:ScoreFactor">
                        <Grid Padding="0,6" ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse
                              Width="8"
                              Height="8"
                              VerticalAlignment="Center"
                              Fill="#16A35E"
                              Visibility="{x:Bind IsProtected, Converter={StaticResource BoolToVisibilityConverter}}" />
                          <Ellipse
                              Width="8"
                              Height="8"
                              VerticalAlignment="Center"
                              Fill="#E88A1A"
                              Visibility="{x:Bind IsProtected, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Detail}" />
                          </StackPanel>
                          <TextBlock
                              Grid.Column="2"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Text="{x:Bind PointsLabel}" />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Expander>
                <Button
                    Margin="0,6,0,0"
                    HorizontalAlignment="Stretch"
                    MinHeight="40"
                    Command="{x:Bind ViewModel.ApplyRecommendedCommand}"
                    IsEnabled="{x:Bind ViewModel.CanApplyRecommended, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72E;" />
                    <TextBlock Text="{x:Bind ViewModel.ImproveButtonLabel, Mode=OneWay}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource HeroCardStyle}">
            <Grid RowSpacing="16">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="36"
                    Height="36"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="18">
                  <FontIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      Glyph="&#xE9D9;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.telemetryTitle'), Mode=OneWay}" />
                  <TextBlock
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.telemetrySubtitle'), Mode=OneWay}" />
                </StackPanel>
              </StackPanel>
              <ComboBox
                  Grid.Row="1"
                  MinHeight="40"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="14,8,36,8"
                  Style="{StaticResource DashboardComboBoxStyle}"
                  ItemsSource="{x:Bind ViewModel.TelemetryLevels}"
                  SelectedItem="{x:Bind ViewModel.SelectedTelemetryLevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:TelemetryLevel">
                    <TextBlock Text="{x:Bind Converter={StaticResource TelemetryLevelToLabelConverter}}" TextWrapping="NoWrap" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button
                  Grid.Row="2"
                  MinHeight="40"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.ApplyTelemetryCommand}"
                  IsEnabled="{x:Bind ViewModel.CanApplyTelemetry, Mode=OneWay}"
                  Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontSize="14" Glyph="&#xE8FB;" />
                  <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.applyTelemetry'), Mode=OneWay}" TextWrapping="NoWrap" />
                </StackPanel>
              </Button>
              <TextBlock
                  Grid.Row="3"
                  VerticalAlignment="Top"
                  FontSize="12"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.telemetryHint'), Mode=OneWay}"
                  TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>

        <Expander
            Margin="0,4,0,20"
            HorizontalAlignment="Stretch"
            Header="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.howTitle'), Mode=OneWay}"
            IsExpanded="False">
          <TextBlock
              MaxWidth="820"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'dashboard.howBody'), Mode=OneWay}"
              TextWrapping="Wrap" />
        </Expander>

        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sections}">
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:PrivacySection">
              <StackPanel
                  Margin="0,4,0,24"
                  Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind Title}" />
                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="{x:Bind Subtitle}" />
                <ItemsRepeater ItemTemplate="{StaticResource SettingCardTemplate}" ItemsSource="{x:Bind Items}">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="16"
                        MinItemWidth="320"
                        MinRowSpacing="16" />
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
              </StackPanel>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
