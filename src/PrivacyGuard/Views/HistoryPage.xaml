<Page
    x:Class="PrivacyGuard.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:vm="using:PrivacyGuard.ViewModels"
    NavigationCacheMode="Disabled">

  <Grid Padding="{StaticResource PagePadding}" RowSpacing="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.title'), Mode=OneWay}" />
      <TextBlock
          Style="{StaticResource PageSubtitleStyle}"
          Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.subtitle'), Mode=OneWay}" />
    </StackPanel>

    <Border
        Grid.Row="1"
        Style="{StaticResource DashboardAlertStyle}"
        Padding="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Background="{ThemeResource DashboardResetStripeBrush}"
            CornerRadius="12,0,0,12" />
        <Grid Grid.Column="1" Padding="14,12,14,12" ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
              Width="36"
              Height="36"
              VerticalAlignment="Center"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              CornerRadius="18">
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="15"
                Glyph="&#xE81C;" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.audit'), Mode=OneWay}" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
          </StackPanel>
          <Button
              Grid.Column="2"
              VerticalAlignment="Center"
              Command="{x:Bind ViewModel.ClearHistoryCommand}"
              IsEnabled="{x:Bind ViewModel.CanClearHistory, Mode=OneWay}"
              Style="{StaticResource HistoryActionButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE74D;" />
              <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.clearButton'), Mode=OneWay}" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <Border Padding="20,18" Style="{StaticResource PrivacyCardStyle}">
        <Grid RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.changes'), Mode=OneWay}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Style="{StaticResource HistoryActionButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72C;" />
                <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'common.refresh'), Mode=OneWay}" />
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel
              Grid.Row="1"
              Orientation="Horizontal"
              Spacing="6">
            <ToggleButton
                Command="{x:Bind ViewModel.SetFilterCommand}"
                CommandParameter="All"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.filterAll'), Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}"
                Style="{StaticResource DashboardFilterChipStyle}" />
            <ToggleButton
                Command="{x:Bind ViewModel.SetFilterCommand}"
                CommandParameter="Active"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.filterActive'), Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsFilterActive, Mode=OneWay}"
                Style="{StaticResource DashboardFilterChipStyle}" />
            <ToggleButton
                Command="{x:Bind ViewModel.SetFilterCommand}"
                CommandParameter="Reverted"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.filterReverted'), Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsFilterReverted, Mode=OneWay}"
                Style="{StaticResource DashboardFilterChipStyle}" />
          </StackPanel>

          <ScrollViewer
              Grid.Row="2"
              BringIntoViewOnFocusChange="False"
              VerticalScrollBarVisibility="Auto">
            <Grid>
              <StackPanel
                  Padding="16,40"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  Visibility="{x:Bind ViewModel.ShowChangesEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                  <FontIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="22"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      Glyph="&#xE81C;" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.EmptyChangesTitle, Mode=OneWay}" />
                <TextBlock
                    MaxWidth="260"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyChangesMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
              </StackPanel>

              <ItemsRepeater
                  ItemsSource="{x:Bind ViewModel.ChangeGroups, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasVisibleChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsRepeater.Layout>
                  <StackLayout Spacing="20" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryDayGroup">
                    <StackPanel Spacing="12">
                      <TextBlock
                          Margin="6,0,0,2"
                          FontSize="12"
                          FontWeight="SemiBold"
                          CharacterSpacing="20"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Text="{x:Bind Title}"
                          Visibility="{x:Bind ShowTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                      <ItemsRepeater ItemsSource="{x:Bind Items}">
                        <ItemsRepeater.Layout>
                          <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate x:DataType="vm:HistoryChangeItem">
                            <Border
                                Padding="0"
                                Background="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBackgroundConverter}}"
                                BorderBrush="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBorderBrushConverter}}"
                                BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                                CornerRadius="12"
                                PointerEntered="HistoryRow_PointerEntered"
                                PointerExited="HistoryRow_PointerExited"
                                Tag="{x:Bind}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="3" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryAccentBrushConverter}}" />
                                <Grid Grid.Column="1" Padding="14,14,14,14" ColumnSpacing="12" RowSpacing="0">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <CheckBox
                                      Width="24"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Margin="0,6,0,0"
                                      Padding="0"
                                      VerticalAlignment="Top"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                  <Border
                                      Grid.Column="1"
                                      Width="40"
                                      Height="40"
                                      VerticalAlignment="Top"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                      CornerRadius="10">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="16"
                                        Glyph="{x:Bind Glyph}" />
                                  </Border>
                                  <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind SettingName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind MetaLabel, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <Border
                                          Padding="10,5"
                                          MaxWidth="240"
                                          Background="{x:Bind OldTone, Converter={StaticResource HistoryToneBrushConverter}, ConverterParameter=bg}"
                                          CornerRadius="9">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{x:Bind OldTone, Converter={StaticResource HistoryToneBrushConverter}}"
                                            Text="{x:Bind OldLabel}"
                                            TextWrapping="Wrap" />
                                      </Border>
                                      <FontIcon
                                          Margin="0,2,0,0"
                                          VerticalAlignment="Center"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="11"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Glyph="&#xE72A;" />
                                      <Border
                                          Padding="10,5"
                                          MaxWidth="240"
                                          Background="{x:Bind NewTone, Converter={StaticResource HistoryToneBrushConverter}, ConverterParameter=bg}"
                                          CornerRadius="9">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind NewTone, Converter={StaticResource HistoryToneBrushConverter}}"
                                            Text="{x:Bind NewLabel}"
                                            TextWrapping="Wrap" />
                                      </Border>
                                    </StackPanel>
                                    <Border
                                        Padding="10,8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                      <StackPanel Spacing="4">
                                        <TextBlock FontSize="12" LineHeight="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                          <Run Text="{x:Bind SettingKeyPrefix}" />
                                          <Run Text="{x:Bind SettingKey}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" LineHeight="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                          <Run Text="{x:Bind SourcePrefix}" />
                                          <Run Text="{x:Bind ProfileLabel}" />
                                        </TextBlock>
                                        <TextBlock
                                            FontSize="12"
                                            LineHeight="18"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind RestorePointLabel}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind RestorePointLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <TextBlock
                                            FontSize="12"
                                            LineHeight="18"
                                            Foreground="#C42B1C"
                                            Text="{x:Bind ErrorLabel}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ErrorLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                                      </StackPanel>
                                    </Border>
                                  </StackPanel>
                                  <Border
                                      Grid.Column="3"
                                      Padding="9,4"
                                      VerticalAlignment="Top"
                                      Background="{ThemeResource HistorySuccessBadgeBackgroundBrush}"
                                      BorderBrush="{ThemeResource HistorySuccessBadgeBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Visibility="{x:Bind IsReverted, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource HistorySuccessBadgeForegroundBrush}"
                                        Text="{x:Bind RevertedLabel}" />
                                  </Border>
                                  <Button
                                      Grid.Column="4"
                                      Width="32"
                                      Height="32"
                                      Padding="0"
                                      VerticalAlignment="Top"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      CornerRadius="8"
                                      Command="{x:Bind ToggleExpandCommand}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="12"
                                        Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                  </Button>
                                </Grid>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </StackPanel>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </Grid>
          </ScrollViewer>

          <Border
              Grid.Row="3"
              Padding="0,16,0,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                  Padding="10,6"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  CornerRadius="8">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Opacity="0.92"
                    Text="{x:Bind ViewModel.ChangeSelectionLabel, Mode=OneWay}" />
              </Border>
              <Button
                  Grid.Column="1"
                  Command="{x:Bind ViewModel.DeleteSelectedChangesCommand}"
                  IsEnabled="{x:Bind ViewModel.CanDeleteChanges, Mode=OneWay}"
                  Style="{StaticResource HistoryActionButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE74D;" />
                  <TextBlock Text="{x:Bind ViewModel.DeleteChangesLabel, Mode=OneWay}" />
                </StackPanel>
              </Button>
              <Button
                  Grid.Column="2"
                  MinHeight="40"
                  Padding="16,8"
                  Command="{x:Bind ViewModel.RevertSelectedCommand}"
                  IsEnabled="{x:Bind ViewModel.CanRevertNow, Mode=OneWay}"
                  Style="{StaticResource AccentButtonStyle}"
                  Visibility="{x:Bind ViewModel.HasSelectedRevertable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE777;" />
                  <TextBlock Text="{x:Bind ViewModel.RevertButtonLabel, Mode=OneWay}" />
                </StackPanel>
              </Button>
              <Button
                  Grid.Column="2"
                  IsEnabled="False"
                  Style="{StaticResource HistoryActionButtonStyle}"
                  Visibility="{x:Bind ViewModel.HasSelectedRevertable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel Opacity="0.72" Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE777;" />
                  <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.revertSelected'), Mode=OneWay}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Padding="18,18" Style="{StaticResource PrivacyCardStyle}">
        <Grid RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="4">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restorePoints'), Mode=OneWay}" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restorePointsSub'), Mode=OneWay}"
                TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer
              Grid.Row="1"
              BringIntoViewOnFocusChange="False"
              VerticalScrollBarVisibility="Auto">
            <Grid>
              <StackPanel
                  Padding="12,40"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  Visibility="{x:Bind ViewModel.ShowRestoreEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                  <FontIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="22"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      Glyph="&#xE8C7;" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.noRestoreTitle'), Mode=OneWay}" />
                <TextBlock
                    MaxWidth="220"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.noRestoreBody'), Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
              </StackPanel>

              <ItemsRepeater
                  ItemsSource="{x:Bind ViewModel.RestoreItems, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasRestorePoints, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsRepeater.Layout>
                  <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryRestoreItem">
                    <Border
                        Background="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBackgroundConverter}, ConverterParameter=restore}"
                        BorderBrush="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBorderBrushConverter}, ConverterParameter=restore}"
                        BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                        CornerRadius="12"
                        PointerEntered="HistoryRow_PointerEntered"
                        PointerExited="HistoryRow_PointerExited"
                        Tag="{x:Bind}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="3" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="3,0,0,3" />
                        <Grid Grid.Column="1" Padding="12,12,12,12" ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox
                              Width="24"
                              MinWidth="0"
                              MinHeight="0"
                              Margin="0,8,0,0"
                              Padding="0"
                              VerticalAlignment="Top"
                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                          <Border
                              Grid.Column="1"
                              Width="40"
                              Height="40"
                              VerticalAlignment="Top"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                              CornerRadius="10">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8C7;" />
                          </Border>
                          <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind Description}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind CreatedAtLabel}"
                                TextWrapping="Wrap" />
                            <Border
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="11"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE8F1;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind SettingCountLabel}" />
                              </StackPanel>
                            </Border>
                            <ItemsRepeater
                                Margin="0,2,0,0"
                                ItemsSource="{x:Bind PreviewSettings}"
                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                              <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                              </ItemsRepeater.Layout>
                              <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                  <TextBlock
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{x:Bind}"
                                      TextWrapping="Wrap" />
                                </DataTemplate>
                              </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                          </StackPanel>
                          <Button
                              Grid.Column="3"
                              Width="32"
                              Height="32"
                              Padding="0"
                              VerticalAlignment="Top"
                              Background="Transparent"
                              BorderThickness="0"
                              CornerRadius="8"
                              Command="{x:Bind ToggleExpandCommand}">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                          </Button>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </Grid>
          </ScrollViewer>

          <Border
              Grid.Row="2"
              Padding="0,16,0,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
              <Border
                  Padding="10,6"
                  HorizontalAlignment="Left"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  CornerRadius="8">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Opacity="0.92"
                    Text="{x:Bind ViewModel.RestoreSelectionLabel, Mode=OneWay}" />
              </Border>
              <Button
                  MinHeight="40"
                  Padding="16,8"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.RestoreSelectedPointCommand}"
                  IsEnabled="{x:Bind ViewModel.CanRestoreNow, Mode=OneWay}"
                  Style="{StaticResource AccentButtonStyle}"
                  Visibility="{x:Bind ViewModel.HasSelectedRestorePoint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE777;" />
                  <TextBlock
                      FontWeight="SemiBold"
                      Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restoreButton'), Mode=OneWay}" />
                </StackPanel>
              </Button>
              <Button
                  MinHeight="40"
                  Padding="16,8"
                  HorizontalAlignment="Stretch"
                  IsEnabled="False"
                  Style="{StaticResource HistoryActionButtonStyle}"
                  Visibility="{x:Bind ViewModel.HasSelectedRestorePoint, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" Opacity="0.72" Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE777;" />
                  <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restoreButton'), Mode=OneWay}" />
                </StackPanel>
              </Button>
              <Button
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.DeleteSelectedRestorePointsCommand}"
                  IsEnabled="{x:Bind ViewModel.CanDeleteRestorePoints, Mode=OneWay}"
                  Style="{StaticResource HistoryActionButtonStyle}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE74D;" />
                  <TextBlock Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.deleteSelected'), Mode=OneWay}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
