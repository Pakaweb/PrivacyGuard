<Page
    x:Class="PrivacyGuard.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:vm="using:PrivacyGuard.ViewModels"
    NavigationCacheMode="Disabled">

  <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.title'), Mode=OneWay}" />
      <TextBlock
          Style="{StaticResource PageSubtitleStyle}"
          Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.subtitle'), Mode=OneWay}" />
    </StackPanel>

    <InfoBar
        Grid.Row="1"
        IsClosable="False"
        IsOpen="True"
        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
        Severity="Informational"
        Title="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.audit'), Mode=OneWay}" />

    <Grid Grid.Row="2" ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <Border Padding="18,16" Style="{StaticResource PrivacyCardStyle}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.changes'), Mode=OneWay}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'common.refresh'), Mode=OneWay}" />
          </Grid>

          <RadioButtons
              Grid.Row="1"
              MaxColumns="3"
              ItemsSource="{x:Bind ViewModel.FilterLabels}"
              SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <StackPanel
                  Padding="16,36"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  Visibility="{x:Bind ViewModel.ShowChangesEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                  <FontIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="22"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      Glyph="&#xE81C;" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.EmptyChangesTitle, Mode=OneWay}" />
                <TextBlock
                    MaxWidth="240"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyChangesMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
              </StackPanel>

              <ItemsRepeater
                  ItemsSource="{x:Bind ViewModel.ChangeGroups, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasVisibleChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsRepeater.Layout>
                  <StackLayout Spacing="14" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryDayGroup">
                    <StackPanel Spacing="8">
                      <TextBlock
                          Margin="4,0,0,2"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Text="{x:Bind Title}"
                          Visibility="{x:Bind ShowTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                      <ItemsRepeater ItemsSource="{x:Bind Items}">
                        <ItemsRepeater.Layout>
                          <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate x:DataType="vm:HistoryChangeItem">
                            <Border
                                Padding="0"
                                Background="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBackgroundConverter}}"
                                BorderBrush="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBorderBrushConverter}}"
                                BorderThickness="1"
                                CornerRadius="10"
                                PointerEntered="HistoryRow_PointerEntered"
                                PointerExited="HistoryRow_PointerExited"
                                Tag="{x:Bind}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="3" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryAccentBrushConverter}}" />
                                <Grid Grid.Column="1" Padding="10,10,12,10" RowSpacing="8">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <CheckBox
                                      Width="24"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Padding="0"
                                      VerticalAlignment="Top"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                  <Border
                                      Grid.Column="1"
                                      Width="36"
                                      Height="36"
                                      Margin="4,0,10,0"
                                      VerticalAlignment="Top"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                      CornerRadius="10">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="16"
                                        Glyph="{x:Bind Glyph}" />
                                  </Border>
                                  <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind SettingName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind MetaLabel, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <Border
                                          Padding="8,3"
                                          Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                          CornerRadius="8">
                                        <TextBlock FontSize="11" Opacity="0.78" Text="{x:Bind OldLabel}" />
                                      </Border>
                                      <FontIcon
                                          VerticalAlignment="Center"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="10"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Glyph="&#xE72A;" />
                                      <Border
                                          Padding="8,3"
                                          Background="{x:Bind NewTone, Converter={StaticResource HistoryToneBrushConverter}, ConverterParameter=bg}"
                                          CornerRadius="8">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind NewTone, Converter={StaticResource HistoryToneBrushConverter}}"
                                            Text="{x:Bind NewLabel}" />
                                      </Border>
                                    </StackPanel>
                                    <Border
                                        Margin="0"
                                        Padding="8,5"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                      <StackPanel Spacing="1">
                                        <TextBlock FontSize="11" LineHeight="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                          <Run Text="{x:Bind SettingKeyPrefix}" />
                                          <Run Text="{x:Bind SettingKey}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" LineHeight="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                          <Run Text="{x:Bind SourcePrefix}" />
                                          <Run Text="{x:Bind ProfileLabel}" />
                                        </TextBlock>
                                        <TextBlock
                                            FontSize="11"
                                            LineHeight="15"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind RestorePointLabel}"
                                            Visibility="{x:Bind RestorePointLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <TextBlock
                                            FontSize="11"
                                            LineHeight="15"
                                            Foreground="#C42B1C"
                                            Text="{x:Bind ErrorLabel}"
                                            Visibility="{x:Bind ErrorLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                                      </StackPanel>
                                    </Border>
                                  </StackPanel>
                                  <Border
                                      Grid.Column="3"
                                      Padding="9,4"
                                      VerticalAlignment="Top"
                                      Background="{ThemeResource HistorySuccessBadgeBackgroundBrush}"
                                      BorderBrush="{ThemeResource HistorySuccessBadgeBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Visibility="{x:Bind IsReverted, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource HistorySuccessBadgeForegroundBrush}"
                                        Text="{x:Bind RevertedLabel}" />
                                  </Border>
                                  <Button
                                      Grid.Column="4"
                                      Width="32"
                                      Height="32"
                                      Padding="0"
                                      VerticalAlignment="Top"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Command="{x:Bind ToggleExpandCommand}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="12"
                                        Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                  </Button>
                                </Grid>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </StackPanel>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </Grid>
          </ScrollViewer>

          <Grid Grid.Row="3" Margin="0,4,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ChangeSelectionLabel, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                MinHeight="40"
                Padding="16,6"
                Command="{x:Bind ViewModel.RevertSelectedCommand}"
                Content="{x:Bind ViewModel.RevertButtonLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanRevertNow, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.HasSelectedRevertable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button
                Grid.Column="1"
                MinHeight="40"
                Padding="16,6"
                Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.revertSelected'), Mode=OneWay}"
                IsEnabled="False"
                Visibility="{x:Bind ViewModel.HasSelectedRevertable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Padding="16" Style="{StaticResource PrivacyCardStyle}">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="2">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restorePoints'), Mode=OneWay}" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Opacity="0.92"
                Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restorePointsSub'), Mode=OneWay}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
              <StackPanel
                  Padding="12,36"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  Visibility="{x:Bind ViewModel.ShowRestoreEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                  <FontIcon
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="22"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      Glyph="&#xE8C7;" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.noRestoreTitle'), Mode=OneWay}" />
                <TextBlock
                    MaxWidth="200"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.noRestoreBody'), Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
              </StackPanel>

              <ItemsRepeater
                  ItemsSource="{x:Bind ViewModel.RestoreItems, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasRestorePoints, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsRepeater.Layout>
                  <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryRestoreItem">
                    <Border
                        Background="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBackgroundConverter}, ConverterParameter=restore}"
                        BorderBrush="{x:Bind CardState, Mode=OneWay, Converter={StaticResource HistoryRowBorderBrushConverter}, ConverterParameter=restore}"
                        BorderThickness="1"
                        CornerRadius="10"
                        PointerEntered="HistoryRow_PointerEntered"
                        PointerExited="HistoryRow_PointerExited"
                        Tag="{x:Bind}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="3" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="3,0,0,3"
                            Opacity="0.85" />
                        <Grid Grid.Column="1" Padding="8,9,8,9" ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox
                              Width="20"
                              MinWidth="0"
                              MinHeight="0"
                              Padding="0"
                              VerticalAlignment="Center"
                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                          <Border
                              Grid.Column="1"
                              Width="32"
                              Height="32"
                              VerticalAlignment="Center"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                              CornerRadius="8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8C7;" />
                          </Border>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind Description}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Opacity="0.92"
                                Text="{x:Bind CreatedAtLabel}" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.82"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind SettingCountLabel}" />
                            <ItemsRepeater
                                Margin="0,2,0,0"
                                ItemsSource="{x:Bind PreviewSettings}"
                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                              <ItemsRepeater.Layout>
                                <StackLayout Spacing="1" />
                              </ItemsRepeater.Layout>
                              <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                  <TextBlock
                                      FontSize="11"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{x:Bind}" />
                                </DataTemplate>
                              </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                          </StackPanel>
                          <Button
                              Grid.Column="3"
                              Width="28"
                              Height="28"
                              Margin="0,0,2,0"
                              Padding="0"
                              VerticalAlignment="Top"
                              Background="Transparent"
                              BorderThickness="0"
                              Command="{x:Bind ToggleExpandCommand}">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                          </Button>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </Grid>
          </ScrollViewer>

          <Border
              Grid.Row="2"
              Padding="0,14,0,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
              <TextBlock
                  FontSize="12"
                  FontWeight="Medium"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{x:Bind ViewModel.RestoreSelectionLabel, Mode=OneWay}" />
              <Button
                  MinHeight="40"
                  Padding="16,6"
                  HorizontalAlignment="Stretch"
                  FontWeight="SemiBold"
                  Command="{x:Bind ViewModel.RestoreSelectedPointCommand}"
                  Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restoreButton'), Mode=OneWay}"
                  IsEnabled="{x:Bind ViewModel.CanRestoreNow, Mode=OneWay}"
                  Style="{StaticResource AccentButtonStyle}"
                  Visibility="{x:Bind ViewModel.HasSelectedRestorePoint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
              <Button
                  MinHeight="40"
                  Padding="16,6"
                  HorizontalAlignment="Stretch"
                  FontWeight="SemiBold"
                  Content="{x:Bind ViewModel.Loc.T(ViewModel.Loc.Stamp, 'history.restoreButton'), Mode=OneWay}"
                  IsEnabled="False"
                  Visibility="{x:Bind ViewModel.HasSelectedRestorePoint, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
