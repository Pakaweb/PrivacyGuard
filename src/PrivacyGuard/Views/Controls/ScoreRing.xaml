<UserControl
    x:Class="PrivacyGuard.Views.Controls.ScoreRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="168"
    Height="168">
  <Grid>
    <Ellipse
        Width="168"
        Height="168"
        Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
        StrokeThickness="12" />
    <Path
        x:Name="ProgressPath"
        StrokeThickness="12"
        StrokeStartLineCap="Round"
        StrokeEndLineCap="Round"
        StrokeLineJoin="Round" />
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
      <TextBlock
          x:Name="ValueText"
          HorizontalAlignment="Center"
          FontSize="40"
          FontWeight="SemiBold"
          LineHeight="44"
          Text="—" />
      <TextBlock
          x:Name="CaptionText"
          HorizontalAlignment="Center"
          Margin="0,-2,0,0"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="out of 100" />
    </StackPanel>
  </Grid>
</UserControl>
